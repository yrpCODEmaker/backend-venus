# ── Almacenamiento (Opcional: Si no se definen, el sistema detecta automáticamente /mnt/db en Linux y cae a home si no existe) ──
# DATABASE_PATH=/mnt/db/venus.db
# UPLOAD_DIR=/mnt/db/uploads

# ── JWT (Requerido) ──
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-SECRET-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Seed (usuario y contraseña inicial) ──
ADMIN_DEFAULT_USERNAME=pichardo
ADMIN_DEFAULT_PASSWORD=admin123
